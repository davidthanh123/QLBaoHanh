@model QLBaoHanh_UNETI04_DHTI17A4HN.ViewModels.HuyPhieuViewModel
@{
    ViewData["Title"] = "Hủy phiếu sửa chữa";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="text-danger fs-1 mb-2"><i class="bi bi-exclamation-triangle"></i></div>
                <h2 class="h4">Xác nhận hủy phiếu @Model.MaPhieu</h2>
                <p class="text-secondary">Bạn chỉ có thể hủy phiếu khi trạng thái đang là <strong>Chờ xử lý</strong>. Hành động này sẽ được lưu cùng lý do hủy.</p>
                <form asp-action="Huy" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="MaPhieu" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="LyDo" class="form-label"></label>
                        <textarea asp-for="LyDo" class="form-control" rows="4" placeholder="Nhập lý do bạn muốn hủy phiếu..."></textarea>
                        <span asp-validation-for="LyDo" class="text-danger small"></span>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Không hủy</a>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle me-1"></i>Xác nhận hủy phiếu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
