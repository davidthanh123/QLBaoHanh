@* Họ và tên: David Thành *@
@* Mã sinh viên: 23103100239 *@
@* Nội dung thực hiện: Trang giới thiệu công khai dạng landing thuyết phục: hook nỗi lo bảo hành, so sánh trước/sau, 3 bước, danh mục thiết bị, hỏi đáp, CTA đăng nhập. *@
@model GioiThieuViewModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Theo dõi bảo hành và sửa chữa thiết bị";
}

@* ============ 1. HERO: đánh vào nỗi lo "hết bảo hành mà không biết" ============ *@
<section class="lp-hero" aria-labelledby="hero-title">
    <div class="lp-container lp-hero-grid">
        <div class="lp-hero-copy">
            <h1 id="hero-title">Đừng để thiết bị hết bảo hành mà bạn không hay biết.</h1>
            <p class="lp-lead">
                Mọi thiết bị và hạn bảo hành nằm sẵn ở một nơi. Máy hỏng thì gửi yêu cầu sửa chữa ngay trên hệ thống,
                rồi xem máy đang được xử lý đến đâu mà không cần gọi điện hỏi.
            </p>
            <div class="lp-hero-actions">
                <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-accent btn-lg">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập để xem thiết bị của tôi
                </a>
                <a href="#loi-ich" class="btn btn-outline-secondary btn-lg">Vì sao nên dùng</a>
            </div>
            <p class="lp-hero-note">Tài khoản do cửa hàng cấp. Đăng nhập là thấy ngay thiết bị của bạn.</p>
        </div>

        <div class="lp-wallet-wrap">
            <article class="lp-wallet card" aria-label="Minh họa danh sách thiết bị và hạn bảo hành">
                <div class="lp-wallet-head">
                    <h2>Thiết bị của tôi</h2>
                    <span class="lp-wallet-sub">3 thiết bị</span>
                </div>
                <ul class="lp-wallet-list">
                    <li class="lp-wallet-item">
                        <i class="bi bi-laptop lp-wallet-icon"></i>
                        <div class="lp-wallet-info"><strong>Laptop Dell Inspiron 15</strong><span class="mono">SN-DL15-48210</span></div>
                        <div class="lp-wallet-status"><partial name="_StatusBadge" model="UiHelper.BaoHanh(DateTime.Today.AddDays(200))" /></div>
                    </li>
                    <li class="lp-wallet-item is-alert">
                        <i class="bi bi-printer lp-wallet-icon"></i>
                        <div class="lp-wallet-info"><strong>Máy in Canon LBP2900</strong><span class="mono">SN-CN29-10377</span></div>
                        <div class="lp-wallet-status"><partial name="_StatusBadge" model="UiHelper.BaoHanh(DateTime.Today.AddDays(12))" /></div>
                    </li>
                    <li class="lp-wallet-item">
                        <i class="bi bi-phone lp-wallet-icon"></i>
                        <div class="lp-wallet-info"><strong>Điện thoại Samsung Galaxy A54</strong><span class="mono">SN-SS54-20931</span></div>
                        <div class="lp-wallet-status"><partial name="_StatusBadge" model="UiHelper.BaoHanh(DateTime.Today.AddDays(-45))" /></div>
                    </li>
                </ul>
                <div class="lp-wallet-foot">
                    <i class="bi bi-bell"></i> Máy in sắp hết hạn: tạo phiếu sửa chữa trước khi quá hạn.
                </div>
            </article>
            <p class="lp-caption">Dữ liệu minh họa</p>
        </div>
    </div>
</section>

@* ============ 2. TRƯỚC / SAU: tình huống quen thuộc ============ *@
<section class="lp-section" id="loi-ich" aria-labelledby="swap-title">
    <div class="lp-container">
        <div class="lp-section-head">
            <h2 id="swap-title">Ba chuyện ai gửi máy đi sửa cũng từng gặp.</h2>
            <p>Và cách QLBaoHanh giải quyết từng chuyện.</p>
        </div>

        <div class="lp-swap">
            <div class="lp-swap-row">
                <div class="lp-swap-before">
                    <span class="lp-swap-label">Thường thì</span>
                    <p>Máy hỏng rồi mới lục tìm hóa đơn xem còn bảo hành hay không.</p>
                </div>
                <div class="lp-swap-after">
                    <span class="lp-swap-label">Với QLBaoHanh</span>
                    <p>Mỗi thiết bị có sẵn hạn bảo hành. Còn bao lâu, hay đã hết, nhìn một lần là biết.</p>
                </div>
            </div>
            <div class="lp-swap-row">
                <div class="lp-swap-before">
                    <span class="lp-swap-label">Thường thì</span>
                    <p>Gửi máy đi rồi phải gọi điện hỏi: sửa tới đâu rồi?</p>
                </div>
                <div class="lp-swap-after">
                    <span class="lp-swap-label">Với QLBaoHanh</span>
                    <p>Phiếu hiện rõ Chờ xử lý, Đang xử lý hay Hoàn thành. Không cần gọi, không cần chờ ai trả lời.</p>
                </div>
            </div>
            <div class="lp-swap-row">
                <div class="lp-swap-before">
                    <span class="lp-swap-label">Thường thì</span>
                    <p>Sửa xong mà không ai nhớ đã thay gì, tốn bao nhiêu.</p>
                </div>
                <div class="lp-swap-after">
                    <span class="lp-swap-label">Với QLBaoHanh</span>
                    <p>Linh kiện và chi phí được ghi vào phiếu, mở lại xem bất cứ lúc nào.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ============ 3. CÁCH DÙNG: 3 bước, nền cobalt đậm ============ *@
<section class="lp-section lp-steps" id="cach-dung" aria-labelledby="steps-title">
    <div class="lp-container">
        <div class="lp-section-head">
            <h2 id="steps-title">Bắt đầu chỉ cần ba bước.</h2>
            <p>Không cài đặt, không giấy tờ. Có tài khoản là dùng được.</p>
        </div>
        <ol class="lp-steps-list">
            <li>
                <span class="lp-steps-num mono">01</span>
                <h3>Đăng nhập</h3>
                <p>Dùng tài khoản được cấp. Thiết bị của bạn đã nằm sẵn trong danh sách.</p>
            </li>
            <li>
                <span class="lp-steps-num mono">02</span>
                <h3>Gửi yêu cầu sửa chữa</h3>
                <p>Chọn thiết bị, mô tả lỗi rồi gửi phiếu. Gửi nhầm thì hủy được khi phiếu còn chờ xử lý.</p>
            </li>
            <li>
                <span class="lp-steps-num mono">03</span>
                <h3>Theo dõi đến khi có kết quả</h3>
                <p>Xem trạng thái phiếu và kết quả xử lý ngay khi kỹ thuật viên cập nhật.</p>
            </li>
        </ol>
        <a asp-controller="TaiKhoan" asp-action="DangNhap" class="lp-steps-link">Đăng nhập và bắt đầu <i class="bi bi-arrow-right"></i></a>
    </div>
</section>

@* ============ 5. DANH MỤC: "thiết bị của bạn có trong danh sách không?" - dữ liệu thật ============ *@
@if (Model.LoaiThietBis.Any())
{
    <section class="lp-section lp-catalog" id="thiet-bi" aria-labelledby="catalog-title">
        <div class="lp-container">
            <div class="lp-section-head">
                <h2 id="catalog-title">Thiết bị của bạn có trong danh sách không?</h2>
                <p>Các loại thiết bị đang được tiếp nhận, kèm thời hạn bảo hành mặc định.</p>
            </div>
            <ul class="lp-chips">
                @foreach (var l in Model.LoaiThietBis)
                {
                    <li class="lp-chip">
                        <strong>@l.TenLoai</strong>
                        <span>@l.HangSanXuat</span>
                        <span class="lp-chip-warranty mono">@l.ThoiHanBaoHanhMacDinh tháng</span>
                    </li>
                }
            </ul>
        </div>
    </section>
}

@* ============ 6. HỎI ĐÁP: gỡ rào cản trước khi bấm đăng nhập ============ *@
<section class="lp-section" id="hoi-dap" aria-labelledby="faq-title">
    <div class="lp-container lp-faq-layout">
        <div class="lp-faq-copy">
            <h2 id="faq-title">Còn băn khoăn gì không?</h2>
            <p>Vài câu hỏi hay gặp trước khi bắt đầu.</p>
        </div>
        <div class="accordion lp-faq" id="faq">
            <div class="accordion-item">
                <h3 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq-1" aria-expanded="true" aria-controls="faq-1">Tôi lấy tài khoản ở đâu?</button></h3>
                <div id="faq-1" class="accordion-collapse collapse show" data-bs-parent="#faq"><div class="accordion-body">Hệ thống không có đăng ký tự do. Tài khoản do quản trị viên cấp, bạn liên hệ nơi gửi thiết bị để được tạo.</div></div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-2" aria-expanded="false" aria-controls="faq-2">Tôi có thấy thiết bị của người khác không?</button></h3>
                <div id="faq-2" class="accordion-collapse collapse" data-bs-parent="#faq"><div class="accordion-body">Không. Khách hàng chỉ xem được thiết bị và phiếu sửa chữa của chính mình.</div></div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-3" aria-expanded="false" aria-controls="faq-3">Gửi nhầm phiếu thì sao?</button></h3>
                <div id="faq-3" class="accordion-collapse collapse" data-bs-parent="#faq"><div class="accordion-body">Phiếu còn ở trạng thái Chờ xử lý thì bạn tự hủy được. Khi kỹ thuật viên đã nhận xử lý, phiếu không hủy được nữa.</div></div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-4" aria-expanded="false" aria-controls="faq-4">Thiết bị hết bảo hành thì có gửi sửa được không?</button></h3>
                <div id="faq-4" class="accordion-collapse collapse" data-bs-parent="#faq"><div class="accordion-body">Bạn vẫn tạo được phiếu sửa chữa. Hệ thống chỉ hiển thị rõ thiết bị đã hết bảo hành để bạn nắm trước.</div></div>
            </div>
        </div>
    </div>
</section>

@* ============ 7. CTA CUỐI ============ *@
<section class="lp-cta" aria-labelledby="cta-title">
    <div class="lp-container lp-cta-inner">
        <div>
            <h2 id="cta-title">Kiểm tra bảo hành thiết bị của bạn ngay hôm nay.</h2>
            <p>Đăng nhập, xem hạn bảo hành, gửi yêu cầu khi cần.</p>
        </div>
        <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-accent btn-lg">
            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập hệ thống
        </a>
    </div>
</section>
