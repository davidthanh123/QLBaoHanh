@*
   Họ và tên: Vân
   Mã sinh viên: 23103100203
   Nội dung thực hiện: Chi tiết loại thiết bị.
*@
@model LoaiThietBi
@{
    ViewData["Title"] = "Chi tiết loại thiết bị";
    var soThietBi = (int)(ViewBag.SoThietBi ?? 0);
}

<div class="page-header">
    <div>
        <h1>@Model.TenLoai</h1>
        <p>@Model.HangSanXuat</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.MaLoai">Sửa loại thiết bị</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="detail-grid">
            <div><dt>Tên loại</dt><dd>@Model.TenLoai</dd></div>
            <div><dt>Hãng sản xuất</dt><dd>@Model.HangSanXuat</dd></div>
            <div><dt>Bảo hành mặc định</dt><dd>@Model.ThoiHanBaoHanhMacDinh tháng</dd></div>
            <div><dt>Số thiết bị thuộc loại này</dt><dd>@soThietBi</dd></div>
            <div><dt>Trạng thái</dt><dd><partial name="_StatusBadge" model="UiHelper.BadgeHoatDong(Model.TrangThai)" /></dd></div>
            <div class="is-wide"><dt>Mô tả</dt><dd>@(string.IsNullOrEmpty(Model.MoTa) ? "—" : Model.MoTa)</dd></div>
        </dl>
    </div>
</div>
