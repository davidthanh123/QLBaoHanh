@*
   Họ và tên: Vân
   Mã sinh viên: 23103100203
   Nội dung thực hiện: Giao diện Đăng nhập (dùng _AuthLayout, hiện lỗi sai thông tin / tài khoản bị khóa).
*@
@model DangNhapViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng nhập";
}

<h5 class="text-center mb-3">Đăng nhập hệ thống</h5>

@if (TempData["ThanhCong"] is string thanhCong)
{
    <div class="alert alert-success" role="alert">@thanhCong</div>
}

<form asp-action="DangNhap" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="mb-3"></div>

    <div class="mb-3">
        <label asp-for="TenDangNhap" class="form-label required"></label>
        <input asp-for="TenDangNhap" class="form-control" autocomplete="username" autofocus placeholder="Nhập tên đăng nhập" />
        <span asp-validation-for="TenDangNhap"></span>
    </div>
    <div class="mb-4">
        <label asp-for="MatKhau" class="form-label required"></label>
        <input asp-for="MatKhau" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" />
        <span asp-validation-for="MatKhau"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
