@* Họ và tên: [điền họ tên của bạn] *@
@* Mã sinh viên: [điền mã sinh viên của bạn] *@
@* Nội dung thực hiện: Module 4 - danh sách và quản lý hồ sơ kỹ thuật viên. *@
@model IEnumerable<KyThuatVien>
@{ ViewData["Title"] = "Kỹ thuật viên"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2 class="h4 mb-1">Kỹ thuật viên</h2><p class="text-muted mb-0">Quản lý hồ sơ nhân viên được phân công xử lý sửa chữa.</p></div>
    <a asp-action="Create" class="btn btn-primary">Thêm kỹ thuật viên</a>
</div>
<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-5"><input class="form-control" name="tuKhoa" value="@ViewBag.TuKhoa" placeholder="Tên, chuyên môn, tài khoản" /></div>
    <div class="col-md-3">
        <select class="form-select" name="trangThai">
            <option value="">Tất cả trạng thái</option>
            <option value="true" selected="@(ViewBag.TrangThai is true)">Đang hoạt động</option>
            <option value="false" selected="@(ViewBag.TrangThai is false)">Ngừng hoạt động</option>
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-primary">Tìm</button><a asp-action="Index" class="btn btn-link">Xóa lọc</a></div>
</form>
<div class="table-responsive card">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Họ tên</th><th>Tài khoản</th><th>Chuyên môn</th><th>Liên hệ</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có kỹ thuật viên phù hợp.</td></tr> }
        @foreach (var ktv in Model)
        {
            <tr>
                <td class="fw-semibold">@ktv.HoTen</td><td>@ktv.TaiKhoan?.TenDangNhap</td><td>@(ktv.ChuyenMon ?? "—")</td>
                <td>@(ktv.SoDienThoai ?? ktv.Email ?? "—")</td>
                <td><partial name="_StatusBadge" model="UiHelper.BadgeHoatDong(ktv.TrangThai)" /></td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@ktv.MaKyThuatVien" class="btn btn-sm btn-outline-primary">Sửa</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
