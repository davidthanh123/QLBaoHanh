
@model IEnumerable<QLBaoHanh_UNETI04_DHTI17A4HN.Models.LinhKien>

@{
    ViewData["Title"] = "Quản lý linh kiện";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Quản lý linh kiện</h2>
            <p class="text-muted mb-0">Quản lý danh sách và số lượng linh kiện tồn kho.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            + Thêm linh kiện
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Index" method="get" class="card card-body mb-3">
        <div class="row g-2">
            <div class="col-md-5">
                <input type="text" name="searchString"
                       value="@ViewBag.SearchString"
                       class="form-control"
                       placeholder="Tìm theo tên linh kiện..." />
            </div>

            <div class="col-md-3">
                <select name="trangThai" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="hoatdong"
                            selected="@(ViewBag.TrangThai == "hoatdong")">
                        Đang hoạt động
                    </option>
                    <option value="ngung"
                            selected="@(ViewBag.TrangThai == "ngung")">
                        Ngừng hoạt động
                    </option>
                </select>
            </div>

            <div class="col-md-2">
                <select name="sapXep" class="form-select">
                    <option value="">Mặc định</option>
                    <option value="gia_tang"
                            selected="@(ViewBag.SapXep == "gia_tang")">
                        Giá tăng dần
                    </option>
                    <option value="gia_giam"
                            selected="@(ViewBag.SapXep == "gia_giam")">
                        Giá giảm dần
                    </option>
                    <option value="ton_tang"
                            selected="@(ViewBag.SapXep == "ton_tang")">
                        Tồn kho tăng dần
                    </option>
                    <option value="ton_giam"
                            selected="@(ViewBag.SapXep == "ton_giam")">
                        Tồn kho giảm dần
                    </option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-success">Lọc</button>
                <a asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
            </div>
        </div>
    </form>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã</th>
                        <th>Tên linh kiện</th>
                        <th>Đơn vị tính</th>
                        <th>Đơn giá</th>
                        <th>Tồn kho</th>
                        <th>Trạng thái</th>
                        <th style="min-width: 180px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MaLinhKien</td>
                                <td>
                                    <strong>@item.TenLinhKien</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.MoTa))
                                    {
                                        <div class="text-muted small">@item.MoTa</div>
                                    }
                                </td>
                                <td>@item.DonViTinh</td>
                                <td>@item.DonGia.ToString("N0") đ</td>
                                <td>
                                    @if (item.SoLuongTon == 0)
                                    {
                                        <span class="text-danger fw-bold">Hết hàng</span>
                                    }
                                    else
                                    {
                                        @item.SoLuongTon
                                    }
                                </td>
                                <td>
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngừng</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@item.MaLinhKien"
                                       class="btn btn-sm btn-outline-info">Chi tiết</a>
                                    <a asp-action="Edit"
                                       asp-route-id="@item.MaLinhKien"
                                       class="btn btn-sm btn-outline-primary">Sửa</a>
                                    <a asp-action="Delete"
                                       asp-route-id="@item.MaLinhKien"
                                       class="btn btn-sm btn-outline-danger">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                Chưa có linh kiện nào hoặc không tìm thấy kết quả.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

