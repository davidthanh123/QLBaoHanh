
@model QLBaoHanh_UNETI04_DHTI17A4HN.Models.LinhKien

@{
    ViewData["Title"] = "Sửa linh kiện";
}

<div class="container-fluid py-3">
    <div class="mb-4">
        <h2>Sửa linh kiện</h2>
        <p class="text-muted">Cập nhật thông tin linh kiện trong kho.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.MaLinhKien" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MaLinhKien" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TenLinhKien" class="form-label"></label>
                    <input asp-for="TenLinhKien" class="form-control" />
                    <span asp-validation-for="TenLinhKien"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DonViTinh" class="form-label"></label>
                        <input asp-for="DonViTinh" class="form-control" />
                        <span asp-validation-for="DonViTinh"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DonGia" class="form-label"></label>
                        <input asp-for="DonGia" type="number"
                               min="0" step="1000" class="form-control" />
                        <span asp-validation-for="DonGia"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="SoLuongTon" class="form-label"></label>
                    <input asp-for="SoLuongTon" type="number"
                           min="0" step="1" class="form-control" />
                    <span asp-validation-for="SoLuongTon"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label"></label>
                    <textarea asp-for="MoTa" rows="3"
                              class="form-control"></textarea>
                    <span asp-validation-for="MoTa"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="TrangThai" class="form-check-input" />
                    <label asp-for="TrangThai" class="form-check-label">
                        Đang hoạt động
                    </label>
                </div>

                <button type="submit" class="btn btn-primary">
                    Lưu thay đổi
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
