
@model QLBaoHanh_UNETI04_DHTI17A4HN.Models.LinhKien

@{
    ViewData["Title"] = "Chi tiết linh kiện";
}

<div class="container-fluid py-3">
    <div class="mb-4">
        <h2>Chi tiết linh kiện</h2>
        <p class="text-muted">Thông tin chi tiết của linh kiện trong kho.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            Thông tin linh kiện #@Model.MaLinhKien
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Mã linh kiện</dt>
                <dd class="col-sm-9">@Model.MaLinhKien</dd>

                <dt class="col-sm-3">Tên linh kiện</dt>
                <dd class="col-sm-9">@Model.TenLinhKien</dd>

                <dt class="col-sm-3">Đơn vị tính</dt>
                <dd class="col-sm-9">@Model.DonViTinh</dd>

                <dt class="col-sm-3">Đơn giá</dt>
                <dd class="col-sm-9">@Model.DonGia.ToString("N0") đ</dd>

                <dt class="col-sm-3">Số lượng tồn</dt>
                <dd class="col-sm-9">
                    @if (Model.SoLuongTon == 0)
                    {
                        <span class="text-danger fw-bold">Hết hàng</span>
                    }
                    else
                    {
                        @Model.SoLuongTon
                    }
                </dd>

                <dt class="col-sm-3">Mô tả</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.MoTa)
                        ? "Chưa có mô tả"
                        : Model.MoTa)
                </dd>

                <dt class="col-sm-3">Trạng thái</dt>
                <dd class="col-sm-9">
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Ngừng hoạt động</span>
                    }
                </dd>
            </dl>
        </div>

        <div class="card-footer d-flex gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.MaLinhKien"
               class="btn btn-primary">Sửa linh kiện</a>

            <a asp-action="Index"
               class="btn btn-secondary">Quay lại danh sách</a>
        </div>
    </div>
</div>
