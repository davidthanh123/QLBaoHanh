
@model QLBaoHanh_UNETI04_DHTI17A4HN.Models.ChiTietSuaChua

@{
    ViewData["Title"] = "Chi tiết sửa chữa";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Chi tiết sửa chữa</h2>
        <a asp-action="Index" class="btn btn-secondary">
            Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Thông tin chi tiết sửa chữa</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Mã chi tiết</dt>
                <dd class="col-sm-9">
                    @Model.MaChiTiet
                </dd>

                <dt class="col-sm-3">Phiếu sửa chữa</dt>
                <dd class="col-sm-9">
                    @(Model.PhieuSuaChua?.NoiDungLoi ?? "Chưa có thông tin")
                </dd>

                <dt class="col-sm-3">Kỹ thuật viên</dt>
                <dd class="col-sm-9">
                    @(Model.KyThuatVien?.HoTen ?? "Chưa có thông tin")
                </dd>

                <dt class="col-sm-3">Tên linh kiện</dt>
                <dd class="col-sm-9">
                    @(Model.LinhKien?.TenLinhKien ?? "Không sử dụng linh kiện")
                </dd>

                <dt class="col-sm-3">Đơn vị tính</dt>
                <dd class="col-sm-9">
                    @(Model.LinhKien?.DonViTinh ?? "—")
                </dd>

                <dt class="col-sm-3">Số lượng</dt>
                <dd class="col-sm-9">
                    @Model.SoLuong
                </dd>

                <dt class="col-sm-3">Đơn giá</dt>
                <dd class="col-sm-9">
                    @Model.DonGia.ToString("N0") VNĐ
                </dd>

                <dt class="col-sm-3">Thành tiền</dt>
                <dd class="col-sm-9 fw-bold text-danger">
                    @Model.ThanhTien.ToString("N0") VNĐ
                </dd>

                <dt class="col-sm-3">Kết quả chẩn đoán</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.KetQuaChanDoan)
                        ? "Chưa có thông tin"
                        : Model.KetQuaChanDoan)
                </dd>

                <dt class="col-sm-3">Ghi chú</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.GhiChu)
                        ? "Không có ghi chú"
                        : Model.GhiChu)
                </dd>
            </dl>
        </div>

        <div class="card-footer d-flex gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.MaChiTiet"
               class="btn btn-warning">
                Sửa thông tin
            </a>

            <a asp-action="Index" class="btn btn-secondary">
                Quay lại danh sách
            </a>
        </div>
    </div>
</div>
