@* Họ và tên: David Thành *@
@* Mã sinh viên: 23103100239 *@
@* Nội dung thực hiện: Layout công khai (bản v2) cho trang giới thiệu, không sidebar. Nạp font theo token (Be Vietnam Pro, JetBrains Mono). *@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? t + " - " : "")QLBaoHanh</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body class="lp-body">
    <header class="lp-header">
        <div class="lp-container lp-header-inner">
            <a class="lp-brand" asp-controller="Home" asp-action="Index" aria-label="QLBaoHanh - Trang chủ">
                <span class="lp-brand-mark"><i class="bi bi-shield-check"></i></span>
                <span class="lp-brand-name">QLBaoHanh<small>Bảo hành và sửa chữa thiết bị</small></span>
            </a>
            <button class="lp-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#lp-navigation" aria-controls="lp-navigation" aria-expanded="false" aria-label="Mở menu">
                <i class="bi bi-list"></i>
            </button>
            <div class="collapse lp-nav-wrap" id="lp-navigation">
                <nav class="lp-nav" aria-label="Điều hướng chính">
                    <a href="#loi-ich">Lợi ích</a>
                    <a href="#cach-dung">Cách dùng</a>
                    <a href="#thiet-bi">Thiết bị</a>
                    <a href="#hoi-dap">Hỏi đáp</a>
                </nav>
                <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-primary lp-login-btn"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</a>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="lp-footer">
        <div class="lp-container lp-footer-main">
            <div class="lp-footer-about">
                <div class="lp-footer-brand"><i class="bi bi-shield-check"></i> QLBaoHanh</div>
                <p>Hệ thống quản lý bảo hành và sửa chữa thiết bị, kết nối khách hàng và đội ngũ kỹ thuật trên cùng một nền tảng.</p>
            </div>
            <nav class="lp-footer-links" aria-label="Liên kết nhanh">
                <h2>Trong trang này</h2>
                <a href="#loi-ich">Lợi ích</a>
                <a href="#cach-dung">Cách dùng</a>
                <a href="#hoi-dap">Hỏi đáp</a>
            </nav>
            <nav class="lp-footer-links" aria-label="Tài khoản">
                <h2>Tài khoản</h2>
                <a asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập hệ thống</a>
            </nav>
        </div>
        <div class="lp-container lp-footer-bottom"><span>© @DateTime.Now.Year QLBaoHanh</span><span>Đề tài 17, UNETI04, DHTI17A4HN</span></div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
