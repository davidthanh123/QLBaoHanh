@*
   Họ và tên: David Thành
   Mã sinh viên: 23103100239
   Nội dung thực hiện: Module 3 - Danh sách khách hàng: tìm kiếm, lọc, phân trang, đổi trạng thái, xóa.
*@
@model KhachHangDanhSachViewModel
@{
    ViewData["Title"] = "Quản lý khách hàng";
    var coLoc = !string.IsNullOrEmpty(Model.TuKhoa) || Model.TrangThai.HasValue || Model.Loai.HasValue;
    const int kichThuocTrang = 10;
}

<div class="page-header">
    <div>
        <h1>Quản lý khách hàng</h1>
        <p>Tra cứu hồ sơ, thêm mới và quản lý trạng thái khách hàng.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm khách hàng</a>
    </div>
</div>

<form method="get" asp-action="Index" class="filter-bar">
    <div class="search">
        <label class="form-label" for="tuKhoa">Từ khóa</label>
        <input class="form-control" id="tuKhoa" name="tuKhoa" value="@Model.TuKhoa" placeholder="Tên, số điện thoại, email hoặc CCCD..." />
    </div>
    <div>
        <label class="form-label" for="loai">Loại khách hàng</label>
        <select class="form-select" id="loai" name="loai">
            <option value="">Tất cả</option>
            @foreach (var l in Enum.GetValues<LoaiKhachHangEnum>())
            {
                <option value="@l" selected="@(Model.Loai == l)">@UiHelper.Badge(l).Text</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label" for="trangThai">Trạng thái</label>
        <select class="form-select" id="trangThai" name="trangThai">
            <option value="">Tất cả</option>
            <option value="true" selected="@(Model.TrangThai == true)">Hoạt động</option>
            <option value="false" selected="@(Model.TrangThai == false)">Ngừng hoạt động</option>
        </select>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Tìm kiếm</button>
        @if (coLoc)
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a>
        }
    </div>
</form>

<div class="table-card">
    @if (Model.TongSo == 0)
    {
        <div class="empty-state">
            <i class="bi bi-people" style="font-size:2rem"></i>
            @if (coLoc)
            {
                <h3>Không tìm thấy khách hàng phù hợp</h3>
                <p>Thử đổi từ khóa hoặc bỏ bớt điều kiện lọc.</p>
            }
            else
            {
                <h3>Chưa có khách hàng nào</h3>
                <p>Bấm "Thêm khách hàng" để tạo hồ sơ đầu tiên.</p>
            }
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Mã KH</th>
                    <th>Khách hàng</th>
                    <th>Liên hệ</th>
                    <th>Loại</th>
                    <th>Tài khoản</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kh in Model.KhachHangs)
                {
                    var tieuDeDoi = kh.TrangThai ? "Ngừng hoạt động" : "Kích hoạt lại";
                    var noiDungDoi = kh.TrangThai
                        ? "Chuyển khách hàng " + kh.HoTen + " sang ngừng hoạt động? Khách đang có phiếu chưa đóng sẽ không ngừng được."
                        : "Kích hoạt lại khách hàng " + kh.HoTen + "?";
                    <tr class="@(kh.TrangThai ? "" : "is-muted")">
                        <td class="mono">@UiHelper.Ma("KH", kh.MaKhachHang)</td>
                        <td>
                            <div class="cell-title">@kh.HoTen</div>
                            <div class="cell-sub">CCCD: @(kh.CCCD ?? "—")</div>
                        </td>
                        <td>
                            <div>@kh.SoDienThoai</div>
                            <div class="cell-sub">@(kh.Email ?? "Chưa có email")</div>
                        </td>
                        <td><partial name="_StatusBadge" model="UiHelper.Badge(kh.LoaiKhachHang)" /></td>
                        <td>@(kh.TaiKhoan?.TenDangNhap ?? "Chưa liên kết")</td>
                        <td><partial name="_StatusBadge" model="UiHelper.BadgeHoatDong(kh.TrangThai)" /></td>
                        <td>@UiHelper.Ngay(kh.NgayTao)</td>
                        <td>
                            <div class="row-actions">
                                <a class="btn btn-ghost btn-icon" asp-action="Details" asp-route-id="@kh.MaKhachHang" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                <a class="btn btn-ghost btn-icon" asp-action="Edit" asp-route-id="@kh.MaKhachHang" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-ghost btn-icon" title="@tieuDeDoi"
                                        data-bs-toggle="modal" data-bs-target="#qbXacNhan"
                                        data-action="@Url.Action("DoiTrangThai", new { id = kh.MaKhachHang })"
                                        data-title="@tieuDeDoi"
                                        data-message="@noiDungDoi"
                                        data-ok="@tieuDeDoi">
                                    <i class="bi @(kh.TrangThai ? "bi-pause-circle" : "bi-play-circle")"></i>
                                </button>
                                <button type="button" class="btn btn-ghost btn-icon is-danger" title="Xóa"
                                        data-bs-toggle="modal" data-bs-target="#qbXacNhan"
                                        data-action="@Url.Action("Xoa", new { id = kh.MaKhachHang })"
                                        data-title="Xóa khách hàng"
                                        data-message="@("Xóa khách hàng " + kh.HoTen + "? Khách đã có thiết bị hoặc phiếu sửa chữa sẽ không xóa được, hãy chuyển sang Ngừng hoạt động.")"
                                        data-ok="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="table-footer">
            <span>
                Hiển thị @((Model.Trang - 1) * kichThuocTrang + 1)–@(Math.Min(Model.Trang * kichThuocTrang, Model.TongSo))
                / @Model.TongSo khách hàng
            </span>
            @if (Model.SoTrang > 1)
            {
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.Trang <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-trang="@(Model.Trang - 1)" asp-route-tuKhoa="@Model.TuKhoa" asp-route-trangThai="@Model.TrangThai" asp-route-loai="@Model.Loai">Trước</a>
                    </li>
                    @for (var p = 1; p <= Model.SoTrang; p++)
                    {
                        <li class="page-item @(p == Model.Trang ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-trang="@p" asp-route-tuKhoa="@Model.TuKhoa" asp-route-trangThai="@Model.TrangThai" asp-route-loai="@Model.Loai">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Trang >= Model.SoTrang ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-trang="@(Model.Trang + 1)" asp-route-tuKhoa="@Model.TuKhoa" asp-route-trangThai="@Model.TrangThai" asp-route-loai="@Model.Loai">Sau</a>
                    </li>
                </ul>
            }
        </div>
    }
</div>

<partial name="_XacNhanModal" />
